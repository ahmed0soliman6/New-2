# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Configuration (Client & Server)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
VITE_CLINIC_SLUG="solimedical-new2"
VITE_INTERNAL_EMAIL_DOMAIN="auth.solimedical.local"

# Server-Only (Vercel Environment Variables ONLY - NEVER add VITE_ prefix or put in AI Studio)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
